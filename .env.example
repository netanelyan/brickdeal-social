# Copy to .env and fill in. .env is gitignored — no key belongs in this repo.

# ---------- Telegram (required — this is the approval surface) ---------------
# From @BotFather. DM the bot /start once, or it can't message you at all.
TG_BOT_TOKEN=
# Where approval cards go — your own user id (message @userinfobot to get it).
# Required: nothing publishes without a tap, so there has to be somewhere to tap.
STAGING_CHAT_ID=
# Your Telegram user id again. The bot refuses to start without it and ignores
# every message, command and button tap from anyone else.
OWNER_ID=

# OPTIONAL: a Telegram channel to publish to as well as Instagram.
# LEAVE BLANK. This deployment publishes to Instagram only; Telegram is the
# approval surface and nothing else. Setting it adds a second destination.
# Leave BLANK for the approval-only setup — the bot still DMs you cards to
# approve, it just has no channel to post them to, and Instagram is the only
# destination. Set it (@YourChannel or the -100... numeric id, bot added as
# ADMIN with Post Messages) to publish to both.
#
# The bot refuses to start if BOTH this and Instagram are unconfigured — an
# approval queue with nowhere to publish silently eats everything you approve.
CHANNEL_ID=

# ---------- Drafting (required) ----------------------------------------------
# Unlike BrickDeal's optional title polish, the writing step is the pipeline —
# without a key there is no candidate.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max. Drafting is a short, well-specified writing
# task; raise it if the Hebrew ever reads flat.
ANTHROPIC_EFFORT=medium

# ---------- Behaviour --------------------------------------------------------
DAILY_TARGET=3            # how many may be awaiting you or approved at once today
# Rejecting a card gives its DAILY_TARGET slot back — a card you turned down is
# not one of "the best two or three a day", and charging the day for it meant
# rejecting the morning's three guaranteed a day with no posts. This is the
# ceiling on how many a day may put in front of you regardless, so the refund
# cannot turn into an endless supply on a day you reject everything.
# Default is DAILY_TARGET x 3.
DAILY_OFFER_CEILING=9
# Ceiling on drafting calls per run — the only step that costs money. Without it
# a day of thin or off-topic sources spends the whole ranked list to produce
# nothing. Default is DAILY_TARGET x 3. /usage in the bot shows what was spent
# and, more usefully, how much of it was thrown away.
MAX_DRAFT_CALLS=9
# How much text a page must carry to be worth a drafting call. Measured, not
# guessed: real sources carried 3,157+ characters, the press-release stubs that
# got drafted and then rejected carried 291 and 346. Two floors because 300
# characters of Japanese is a paragraph and 300 of English is a sentence.
MIN_SOURCE_CHARS=1200
MIN_SOURCE_CHARS_CJK=700
# Lower again for content that arrived in a feed: a feed item carries no menus
# or breadcrumbs, so the same count buys more substance. A full Smithsonian
# volcano report is 779 characters.
MIN_SOURCE_CHARS_FEED=450
# How long headless Chromium stays warm after the last render. It is needed for
# a few seconds a day; holding ~200MB for the other 23 hours on a shared VPS is
# the waste. 0 closes it immediately after every card.
RENDER_IDLE_MS=300000
# The gather runs REPEATEDLY through the day, between RUN_HOUR and
# GATHER_UNTIL_HOUR, every GATHER_EVERY_HOURS — so a source that publishes at
# 14:00 reaches you at 14:00 rather than at 11:00 tomorrow. DAILY_TARGET and
# DAILY_OFFER_CEILING still cap the day, counted in the store, so more looking
# never means more posts.
RUN_HOUR=8                # first hour a gather may run (server local time)
GATHER_UNTIL_HOUR=22      # last hour a gather may start - nothing overnight
GATHER_EVERY_HOURS=2      # how often to look, inside those hours
POST_INTERVAL_MINUTES=240 # drip: one approved post every N minutes
SEEN_TTL_DAYS=45          # a source item can come back around after N days

# ---------- Topic mix --------------------------------------------------------
# Enforced arithmetically over a rolling window of what actually published, so
# no single thread can quietly take over the feed. See /mix in the bot.
KOSHER_MAX_SHARE=0.15     # at most ~1 post in 7 carries the kosher/Shabbat tag
PILLAR_MAX_SHARE=0.4      # no single pillar takes more than 40% of the window
QUOTA_WINDOW_DAYS=30
QUOTA_MIN_SAMPLE=8        # below this many published posts the shares are noise

# ---------- Monitoring (Hebrew DMs to STAGING_CHAT_ID) -----------------------
REJECT_NOTIFY=digest      # off | each | digest — visibility into what got filtered
REJECT_DIGEST_HOURS=6
# Alert once if nothing has been staged, or if any single destination has not
# published, for this long. Per destination on purpose: Telegram publishing
# every day while Instagram was blocked at the API is exactly the outage a
# global "did anything publish" check reports as healthy.
QUIET_ALERT_HOURS=30
# Consecutive failures before a destination is called broken: it stops being
# attempted, approved posts are held for it instead of dropped, and you get one
# escalation rather than the same warning on every card. /retry clears it.
TARGET_DEGRADE_AFTER=3

# ---------- Cards ------------------------------------------------------------
# Where rendered JPEGs are written. Leave BOTH of these commented out while
# testing locally — they default to ./out/cards, and the VPS path below would
# otherwise resolve somewhere odd on a dev machine.
#
# On the VPS this points into the directory Caddy already serves, the same way
# BrickDeal's DEALS_PATH points at the web root.
#CARD_OUTPUT_DIR=/var/www/tiyul/cards
# The public HTTPS base for that directory. REQUIRED FOR INSTAGRAM: the Graph API
# takes an image_url that Instagram's own servers fetch themselves, so a card
# that exists only on local disk cannot be published — no matter how correct
# everything else is. Must be https; http is rejected up front.
#CARD_PUBLIC_BASE_URL=https://tiyul.example.com/cards

# ---------- Instagram (the publish target) -----------------------------------
# Official Graph API only. Needs an Instagram Business/Creator account linked to
# a Facebook Page, and an app with instagram_basic + instagram_content_publish +
# pages_read_engagement. IG_ACCESS_TOKEN must be the PAGE token derived from a
# long-lived user token — see SETUP.md §3.3. The wrong one works fine and then
# dies after 60 days.
#
# These three plus CARD_PUBLIC_BASE_URL are what switch Instagram on. Without
# them you need CHANNEL_ID instead, or the bot won't start.
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_API_VERSION=v21.0

# ---------- TikTok (optional publish target) ---------------------------------
# Content Posting API, Direct Post, photo posts. The card is published as a
# photo — TikTok fetches it from CARD_PUBLIC_BASE_URL itself, exactly as
# Instagram does, so that variable is required here too. There is no
# byte-upload path for images.
#
# TWO THINGS THAT FAIL SILENTLY IF YOU SKIP THEM:
#   - The domain in CARD_PUBLIC_BASE_URL must be verified under URL properties
#     in the developer portal, or every post fails with url_ownership_unverified.
#   - TIKTOK_REDIRECT_URI must match what is registered there character for
#     character, including the trailing slash or its absence.
#
# The tokens themselves are NOT here: `npm run tiktok-token` writes them to
# data/store.json, because the access token lasts ~24h and is refreshed
# constantly — a value in .env would be stale within a day.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Which privacy level the approval message offers first. Only ever used if the
# account actually has it: what is available comes from TikTok per post, and an
# app that has not passed audit is given SELF_ONLY and nothing else. Leave unset
# to default to the most private level available, which is the right way round
# for a default.
#   PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
#TIKTOK_PRIVACY=

# ---------- Slideshows (/deck) -----------------------------------------------
# A deck is built idea-first: Claude proposes what to make, OpenStreetMap and
# Wikidata say which places exist and how well known they are, and then every
# fact that reaches a slide is quoted from the official site of the place or of
# the body that runs it.
#
# Google Programmable Search is what finds that page. Without it the pipeline
# falls back to whatever homepage Wikidata records, and a homepage rarely states
# opening hours — so decks will mostly fail the evidence check. Create a search
# engine at programmablesearchengine.google.com set to "search the entire web"
# (the code restricts every query to one site itself), then take the key from
# the Custom Search JSON API in Google Cloud.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Free tier is 100 queries/day and one deck of five costs about five. The bot
# stops at this number rather than letting the quota run out mid-deck.
#GOOGLE_CSE_DAILY=90

# How few slides is still a deck. Below this /deck refuses and reports which
# places were dropped and why, rather than publishing a two-slide list.
#DECK_MIN_SLIDES=3
# Characters before a slide line is rendered one size down. The line is never
# dropped — it was verified against a source, and hiding a verified fact is
# worse than a slightly smaller line.
#DECK_LINE_MAX=34
# Public Overpass is the default and is rate-limited; a private instance or a
# mirror goes here if decks start hitting 429.
#OVERPASS_URL=https://overpass-api.de/api/interpreter
# Nominatim and Overpass both refuse the default fetch user agent. Identify
# yourself honestly — this is their stated condition of use, not a workaround.
#PLACES_USER_AGENT=tiyul-plus/1.0 (contact: you@example.com)

# ---------- Images -----------------------------------------------------------
# Only three origins are ever permitted: commercial-license stock, our own
# catalogue, or AI-generated. Never an image from a news article or a business's
# own page. Whichever was used is shown in the approval message and printed on
# the card.
#
# Set this and the photo layouts become available - the drafting step is told
# images can be fetched, picks a photo layout when the story warrants one, and
# supplies an English search term. Free key: https://www.pexels.com/api/
# Pexels' licence permits commercial use and requires no attribution; we credit
# the photographer on the card anyway.
PEXELS_API_KEY=
# Leave blank unless implemented - src/images.js refuses rather than publishing
# an image whose provenance it cannot name.
CATALOGUE_DIR=
IMAGE_GEN_API_KEY=

# ---------- Branding ---------------------------------------------------------
BRAND_NAME=טיול+
# Appended to the Instagram caption as a single short line. Blank = no line.
# The caption deliberately carries no source URL (unclickable on Instagram);
# the card's own footer prints the source domain instead.
SITE_URL=https://tiyulplus.com
