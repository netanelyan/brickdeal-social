# BrickDeal social — copy to .env and fill in.
#
# .env is gitignored, along with every .env.* variant. Nothing else reads a
# credential, and src/env.js is a ~10-line loader rather than a dependency.
#
# Only the first block is required. Everything under it degrades rather than
# failing: with no Brickset key the slides carry prices and no comparison, with
# no image key they carry catalogue photographs and say so on the approval
# card, and with no Anthropic key the cover line comes from the pool in
# brick-config.json. A deck still comes out of all three.

# ---------- Required -------------------------------------------------------

# From @BotFather.
TG_BOT_TOKEN=

# Your own Telegram user id — message @userinfobot to get it. This is where
# proposals and approval cards arrive.
STAGING_CHAT_ID=

# The same id. The bot checks every update against it in middleware registered
# before any other handler, and refuses to start without it: a missing config
# value must fail closed rather than opening the bot to whoever finds the
# username.
OWNER_ID=

# ---------- The deal feed --------------------------------------------------

# Where the deals come from. This is the feed brickdeal-automation produces and
# brickdeal-website publishes — the same file, with the contract documented in
# that repo's README.
#
# The URL is tried first, then the file. A local file is the right thing while
# testing; on the VPS point it at the published feed so the slideshow and the
# site are always talking about the same deals.
BRICKDEAL_FEED_URL=https://brickdeal.co.il/deals.json
BRICKDEAL_FEED_FILE=

# How stale a price may be before a deal stops being publishable.
#
# Fourteen days is the website's own threshold — past it a card there dims and
# its date turns red. The same number here is not a coincidence to be tidied
# away: if the nightly refresh job dies, the site visibly greys out and this
# pipeline stops producing slides, and those two failures should become visible
# on the same day rather than a fortnight apart.
#
# A slide has no warning band. Once a price is on TikTok it cannot be dimmed.
FEED_MAX_AGE_DAYS=14

# ---------- The comparison price -------------------------------------------

# Free key: https://brickset.com/tools/webservices/requestkey
#
# This is where the middle line on every slide comes from — the original brand's
# recommended retail price, looked up by set number. Without it there is no
# comparison and no saving line, and the slide carries the price alone. That is
# a correct slide, not a broken one, but it is also the post's whole hook.
BRICKSET_API_KEY=

# A retail price does not move, so the cache is about the key's daily quota
# rather than about accuracy: only getSets counts against it, and a seven-set
# deck would otherwise spend seven calls every time it is rebuilt.
RRP_TTL_DAYS=30

# The smallest saving worth printing. Below this the comparison line is dropped
# rather than shown, because "you saved 6₪" undercuts the ones that matter.
MIN_SAVING_ILS=20

# ---------- The photographs ------------------------------------------------

# The single most important thing in this pipeline, and the hardest to automate.
#
# What makes the format work is that the pictures look like somebody's own
# builds photographed at home. A marketplace catalogue image will look like a
# catalogue image no matter what type is laid over it. So the product photo is
# restaged by an image model, using the prompt from the brickdeal-product-shot
# skill, and what comes back is checked against the original by a cheap vision
# call before it is used.
#
# A Gemini API key. Without it every slide falls back to the catalogue photo
# with its provenance changed, which the approval card prints — the decision to
# publish one anyway is made by a person looking at it.
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=gemini-2.5-flash-image

# The model that checks the generated photo shows the same set the link sells.
# Any failure here is a "no", never a pass: the fallback costs a nicer
# photograph, a false pass costs a post that shows one product and sells
# another.
IMAGE_VERIFY_MODEL=claude-haiku-4-5-20251001

# ---------- The cover line -------------------------------------------------

# Optional. One short call per deck writes the hook on the first slide. Without
# a key the hook is drawn from covers.lines in brick-config.json, which are the
# reference account's own covers with the trademark taken out.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------- Pacing ---------------------------------------------------------

# How many deck proposals may arrive unasked in a day, and how many may sit
# unanswered before the bot stops offering. A proposal is free — the feed is a
# file and the prices are cached — so what this paces is your attention.
DECKS_PER_DAY=2
DECK_BACKLOG_MAX=3

# The hours a proposal may arrive in, and how often the timer may offer one.
RUN_HOUR=8
GATHER_UNTIL_HOUR=22
GATHER_EVERY_HOURS=2

# One approved post publishes every N minutes, so a day's approvals do not
# arrive on the feed in a burst.
POST_INTERVAL_MINUTES=240

# A set cannot appear on two slideshows inside this window.
SEEN_TTL_DAYS=45
QUOTA_WINDOW_DAYS=30

# Nothing has reached you in this many hours -> say so. A silent bot and a
# working one look identical from the outside.
QUIET_ALERT_HOURS=30

# ---------- Instagram ------------------------------------------------------

# A deck also publishes as a carousel. Needs an Instagram Business account
# through the Graph API.
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_API_VERSION=v21.0

# Instagram fetches the slide images from a public URL rather than receiving
# the bytes, so the rendered JPEGs have to be reachable over HTTPS. This is why
# the bot has to run on a box with a domain pointing at it.
CARD_PUBLIC_BASE_URL=
CARD_OUTPUT_DIR=

# ---------- TikTok ---------------------------------------------------------

# Connected once with `npm run tiktok-token`. Only these three go in .env — the
# access token lasts a day and is refreshed continuously, so it lives in the
# store rather than here.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# ---------- Branding -------------------------------------------------------

# Printed nowhere on a slide. The watermark text lives in brick-config.json,
# and no caption may carry a URL — assertNoUrl refuses one at build time.
SITE_URL=https://brickdeal.co.il

# ---------- Rarely touched -------------------------------------------------

# How long a headless Chromium is kept warm after the last render. A deck's
# slides come in a burst; the other 23 hours it is just resident memory.
RENDER_IDLE_MS=300000

# Where the caches live. Overridden by the test suite so `npm test` on the VPS
# cannot touch the live store, the cached exchange rate or the set prices.
STORE_PATH=
FX_CACHE_PATH=
RRP_CACHE_PATH=
SHOT_CACHE_DIR=
