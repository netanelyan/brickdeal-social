node_modules/
.env
# Any variant. A .env.bak from a one-line edit is the same secrets with a
# different extension, and it would not have been ignored.
.env.*
!.env.example

# Runtime state: dedupe history, publish queue, staging, the published log the
# pillar quotas are computed from. Same reasoning as BrickDeal's — cloning this
# repo shouldn't leak what has already gone out.
data/

# Rendered cards. Regenerable from the candidate at any time, and on the VPS
# these are written straight into the Caddy web root instead (CARD_OUTPUT_DIR).
out/

# Pre-change backups taken on the VPS. `.env.*` above already catches the env
# copies wherever they sit, but a store.json backup is the TikTok and Instagram
# token pair under a name `data/` does not match — the one file here that would
# have been committable.
backups/

# Sample cards from `npm run render-samples` — a local eyeballing aid, not an
# artifact worth versioning. Anchored with a leading slash: unanchored, it also
# matched assets/samples/, which is checked in on purpose for the README.
/samples/

# Reference only. BrickDeal is a separate project, read while building this one
# and never imported from at runtime. It was committed here by accident; it
# stays on disk as a local reference and out of this repository.
brickdeal-automation-main/
